# ---------------------------------------------------------------------------
# MyWebApp - local Docker development environment
# ---------------------------------------------------------------------------
# Copy this file to .env.docker.local and fill in real values.
# .env.docker.local is git-ignored and must never be committed.
#
# Load with:
#   docker run --env-file .env.docker.local ...
# or via compose.yaml's env_file directive.
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------

# age private key used to decrypt application secrets at startup.
# Obtain from ~/.config/sops/age/keys.txt, stripping comment lines:
#   grep -v '^#' ~/.config/sops/age/keys.txt
AGE_KEY=AGE-SECRET-KEY-REPLACE_ME

# --- Database --------------------------------------------------------------

# From inside a container, "localhost" refers to the container itself.
# Use host.docker.internal to reach PostgreSQL running on the host.
# On Linux this name requires --add-host host.docker.internal:host-gateway
# (or the extra_hosts entry in compose.yaml).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=pmjtoca
DB_NAME=MyWebApp

# Disable TLS for local development only. Never use "disable" in production.
DB_SSLMODE=disable

# --- Application -----------------------------------------------------------

# Port the application listens on inside the container.
APP_PORT=8080

# Log level for local development. Use "info" or "warn" in production.
LOG_LEVEL=debug