# =============================================================================
# mywebapp configuration — example
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# .env is gitignored.
#
# Secrets do not appear in this file. They live in secrets.enc.yaml and
# are decrypted at boot by internal/credentials. To edit them, run:
#
#     sops secrets.enc.yaml
#
# after installing sops and configuring the age key. See the README for
# the key setup.
# =============================================================================

APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=REPLACE_ME
DB_NAME=mywebapp
DB_SSLMODE=disable

DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=30s

TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=REPLACE_ME
TEST_DB_NAME=mywebapp_test
TEST_DB_SSLMODE=disable

PORT=8080

LOG_FORMAT=json
LOG_LEVEL=info
GIN_MODE=debug

# MAX_REQUEST_BODY_BYTES=1048576

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

CSP_REPORT_ONLY=true
CSP_REPORT_URI=
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=
COOP=same-origin
CORP=same-origin

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

CSRF_FORM_FIELD=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_LENGTH=32
CSRF_COOKIE_MAX_AGE=0

R2_BUCKET_NAME=
R2_IMAGE_KEY=welcome.jpg
R2_ACCOUNT_ID=