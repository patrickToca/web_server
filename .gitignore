# =============================================================================
# .gitignore
# =============================================================================
# Patterns in this file are ordered from most specific to least specific.
# When two patterns match the same path, the last one wins. Negations
# (!) must come after the pattern they override.
#
# The general rule for this repository: name files explicitly rather
# than relying on wildcards that span categories. A wildcard that
# catches one file too many is worse than one line of duplication.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment and secrets
# -----------------------------------------------------------------------------
# .env holds configuration only and is gitignored. The patterns are
# here for the case where someone temporarily puts a secret in it by
# mistake.
.env
.env.*
!.env.example
!.env.docker.local.example

# The filled-in local Docker env file specifically. Listed separately
# because it is more specific than the .env.* pattern above and the
# file is easy to forget.
.env.docker.local

# SOPS: the plaintext working copy and any decrypted form.
#
# The encrypted file (secrets/secrets.enc.yaml) is committed. Nothing
# in this block matches it. The patterns below name the specific
# plaintext forms rather than using a wildcard, so a future rename of
# the encrypted file cannot accidentally sweep it into the ignore
# list.
secrets/secrets.yaml
secrets/secrets.yml
secrets/secrets.env
secrets.yaml
secrets.yml
secrets.env

# The makefile's cached decryption. Written with mode 0600 by
# `make load-secrets` and removed by `make clean` or `make
# clear-secrets`. Contains plaintext database passwords.
.make-secrets.env
.make-secrets.env.tmp

# Local age key material. The private key lives in the developer's
# home directory, not in the repo, but these patterns catch the case
# where someone copies it here to debug.
age-keys.txt
keys.txt
*.agekey

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Local Compose override file for machine-specific settings. The
# committed compose file is compose.yaml; only the override is
# machine-specific.
compose.override.yaml
compose.override.yml

# -----------------------------------------------------------------------------
# Runtime output
# -----------------------------------------------------------------------------
logs/
*.log

# The application's PID file, written by `make start`.
.pid

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
bin/
dist/
*.test
*.exe

# Go
*.out
vendor/

# Node
node_modules/

# Tailwind CSS output. The file is generated by `npm run build:css`;
# the source is in static/css/input.css and the Tailwind config.
static/css/output.css
output.css

# -----------------------------------------------------------------------------
# Test and coverage
# -----------------------------------------------------------------------------
coverage.out
coverage.raw
coverage.src
coverage.html
coverage-src.html

# -----------------------------------------------------------------------------
# Local data
# -----------------------------------------------------------------------------
# Any directory used during development that must never be committed.
data/

# -----------------------------------------------------------------------------
# Editor and OS
# -----------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~