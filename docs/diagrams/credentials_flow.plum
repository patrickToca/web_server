@startuml credentials-flow
!theme cerulean-outline
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 180

' Participant colours. Each one is a different role in the flow.
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0

skinparam participantBackgroundColor #F3E5F5
skinparam participantBorderColor #6A1B9A

skinparam databaseBackgroundColor #FFF3E0
skinparam databaseBorderColor #E65100

' ------------------------------------------------------------------
' Participants
' ------------------------------------------------------------------
actor      "Developer"        as Dev   #E3F2FD
participant "Local\nRepository" as Local  #F3E5F5
database   "GitHub\n(private)"  as GitHub #FFF3E0
participant "Fly.io\nBuild"     as Build  #E8F5E9
participant "Container\nImage"  as Image  #E8F5E9
participant "mywebapp\nprocess" as App    #E1F5FE
database   "SOPS\nlibrary"      as SOPS   #FCE4EC
participant "Fly\nSecrets"      as FlySec #FFEBEE

' ------------------------------------------------------------------
' Phase 1 — authoring and committing
' ------------------------------------------------------------------
group #E8F5E9 Author secrets  (developer's machine)

    Dev   -> Local  : create secrets.yaml\n(plaintext, not committed)
    activate Local

    Dev   -> SOPS   : sops -e secrets.yaml > secrets.enc.yaml
    activate SOPS
    SOPS  --> Local : secrets.enc.yaml\n(values encrypted, keys readable)
    deactivate SOPS

    Dev   -> Local  : rm secrets.yaml
    note right of Local
      Plaintext is gone.
      Only the encrypted form remains.
    end note

    Dev   -> Local  : git add secrets.enc.yaml\ngit commit\ngit push
    deactivate Local
end

' ------------------------------------------------------------------
' Phase 2 — one-time bootstrap secret
' ------------------------------------------------------------------
group #FFEBEE Bootstrap the age key  (one time)

    Dev    -> FlySec : fly secrets set\nAGE_KEY="$(cat ~/.config/sops/age/keys.txt)"
    activate FlySec
    note right of FlySec
      Value is encrypted at rest.
      Write-only: cannot be read back.
    end note
    FlySec --> Dev   : rolling restart triggered
    deactivate FlySec
end

' ------------------------------------------------------------------
' Phase 3 — build and deploy
' ------------------------------------------------------------------
group #E8F5E9 Build and deploy

    Dev   -> GitHub : git push
    activate GitHub
    Dev   -> Build  : fly deploy
    activate Build

    Build -> GitHub : fetch repository\n(contains secrets.enc.yaml)
    GitHub --> Build : source + encrypted secrets
    deactivate GitHub

    Build -> Image  : build container\nCOPY secrets.enc.yaml /app/
    activate Image
    note right of Image
      Ciphertext is in the image.
      The age key is NOT.
    end note
    Image --> Build : image ready
    deactivate Image

    Build -> App    : start process\n(env: AGE_KEY from Fly Secrets)
    deactivate Build
    activate App
end

' ------------------------------------------------------------------
' Phase 4 — boot and decryption
' ------------------------------------------------------------------
group #E1F5FE Boot  (inside the container)

    App -> App      : credentials.Load()
    activate App #B3E5FC

    App -> FlySec   : read AGE_KEY
    activate FlySec
    FlySec --> App  : age private key
    deactivate FlySec

    App -> SOPS     : decrypt secrets.enc.yaml\n(using AGE_KEY)
    activate SOPS
    note right of SOPS
      Decrypts values only.
      Keys remain readable.
    end note
    SOPS --> App    : map[string]string\n{JWT_SECRET, CSRF_SECRET, ...}
    deactivate SOPS

    App -> App      : validate:\n- required keys present\n- signing keys >= 32 bytes\n- JWT != CSRF
    note right of App
      In production:\nmissing or short secret\naborts the boot.
    end note

    App -> App      : os.Setenv(JWT_SECRET, ...)\nos.Setenv(CSRF_SECRET, ...)
    note right of App
      Secrets are now ordinary\nenvironment variables.
      The rest of the app reads\nthem via os.Getenv.
    end note

    deactivate App

    App --> App     : auth.NewJWTService()\nmiddleware.LoadCSRFConfig()
    note right of App
      Both constructors read\nos.Getenv and succeed.
    end note
end

' ------------------------------------------------------------------
' Phase 5 — serve
' ------------------------------------------------------------------
group #FFF8E1 Serve

    App -> App : start HTTP server\nlisten on :8080
    App --> Dev : application available
end

' ------------------------------------------------------------------
' Legend
' ------------------------------------------------------------------
legend right
  |= Colour |= Meaning |
  |<#E3F2FD> | Developer action |
  |<#F3E5F5> | Local filesystem |
  |<#FFF3E0> | External repository |
  |<#FFEBEE> | Fly Secrets (write-only) |
  |<#E8F5E9> | Build pipeline |
  |<#E1F5FE> | Application process |
  |<#FCE4EC> | SOPS library |
endlegend

@enduml